# Google Sheets configuration
GOOGLE_SERVICE_ACCOUNT_JSON="/path/to/your/service-account.json"
GOOGLE_SHEET_ID="your-google-sheet-id-here"

# Sync configuration
# How many days back to look beyond the last sync timestamp
SYNC_THRESHOLD_DAYS=7
# Extra days margin on both ends of the time window
DATE_MARGIN_DAYS=3

# iDiscGolf configuration
IDISCGOLF_BASE_URL="https://idiscgolf.cz"
IDISCGOLF_API_TOKEN="your-idiscgolf-api-token"
